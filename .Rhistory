#Fecundity
numbofcap <- function(x, a) {
fake_data <- expand.grid(
year = annees,
Pop = populations,
Size0Mars = x,
Age = a)
mu <- exp(predict(Cptlglm1, fake_data))
mu2 <- aggregate(mu, list(fake_data$Size0Mars), mean)
mu2$V1[mu2$Group.1<5] <- 0
nbcap <- ifelse(mu2$V1>=0,mu2$V1,0)
return(matrix(nbcap, length(x), length(x), byrow = T))
}
load("obs_beta")
load("se_obs_beta")
minbeta <- -20-obs_beta
maxbeta <- 5-obs_beta
beta <- seq(minbeta,maxbeta,1)
lam <- NULL
mu_size <- NULL
mu_a <- NULL
lambda_asy <- lambda(super_matrix(0))
for (i in 1:length(beta)) {
MatrixIPM <- super_matrix(beta[i])
lam[i] <- lambda(MatrixIPM)
A <- eigen.analysis(MatrixIPM)
N <- matrix(ncol = 8, nrow = 50)
for (j in 1:8) {
N[, j] <- A$stable.stage[(50 * (j - 1) + 1):(50 * j)]
}
V <- function(age) {
return(N[(50 * (age - 1) + 1):(50 * age)])
}
mu_size[i] <- sum(ymid.1 * V(1) * flr0(ymid.1, 1, beta[i]))
mu_a[i] <- sum(V(1) * flr0(ymid.1, 1, beta[i]))
mu2 <- sum(V(1) * flr0(ymid.1, 1, beta[i]))
for (a in 2:8) {
mu_size[i] <- mu_size[i] + sum(ymid.a * V(a) * flr0(ymid.a, a, beta[i]))
mu_a[i] <- mu_a[i] + sum(a * V(a) * flr0(ymid.a, a, beta[i]))
mu2 <- mu2 + sum(V(a) * flr0(ymid.a, a, beta[i]))
}
mu_size[i] <- mu_size[i] / mu2
mu_a[i] <- mu_a[i] / mu2
}
pos <- order(lam)
maxibeta <- beta[pos[length(pos)]]
plot(x=beta+obs_beta,y=lam,type = 'line',xlab="Beta" ,ylab="Growth rate") ; abline(v=obs_beta,col="green4",lty=2) ; abline(v=obs_beta-se_obs_beta,lty=2) ; abline(v=obs_beta+se_obs_beta,lty=2) ;  abline(h=lambda_asy,lty=2,col="green4") ;
x_pos <- beta[1:length(mu_size)] + obs_beta
axis(side = 3, at = x_pos, labels = round(mu_size, 1), cex.axis = 0.7)
mtext("Mean size at flowering", side = 3, line = 2)
abline(v=maxibeta+obs_beta,col="red")
abline(h=max(lam[1:20]),col="red",lty=3)
