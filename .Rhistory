opti_size_popyear <- matrix(NA, length(populations), length(annees))
opti_a_popyear <- matrix(NA, length(populations), length(annees))
opti_beta_popyear <- matrix(NA, length(populations), length(annees))
lam_opti_popyear <- matrix(NA, length(populations), length(annees))
for (p in 1:6) {
for (yr in 2:length(annees)) {
year <- annees[yr]
pop <- populations[p]
print(p)
functionlambda <- function(beta) {
return(lambda(super_matrix(beta, Pop = pop, year = year)))
}
opti <- optimize(
f = functionlambda,
maximum = TRUE,
lower = -25,
upper = 5,
tol = 0.001)
lam_opti_popyear[p,yr] <- opti$objective
beta <- opti$maximum
A <- eigen.analysis(IPMKernalPopYear_AIC[[(p-1)*length(annees)+yr-1]])
N <- matrix(ncol = 8, nrow = 50)
for (i in 1:8) {
N[, i] <- A$stable.stage[(50 * (i - 1) + 1):(50 * i)]
}
W <- function(age) {
return(N[(50 * (age - 1) + 1):(50 * age)])
}
mu_size <- sum(ymid.1*W(1)*flr0(ymid.1,1,beta,Pop=pop,year=year))
mu_a <- sum(W(1)*flr0(ymid.1,1,beta,Pop=pop,year=year))
mu2 <- sum(W(1)*flr0(ymid.1,1,beta,Pop=pop,year=year))
for(a in 2:8){
mu_size <- mu_size + sum(ymid.a*W(a)*flr0(ymid.a,a,beta,Pop=pop,year=year))
mu_a <- mu_a + sum(a*W(a)*flr0(ymid.a,a,beta,Pop=pop,year=year))
mu2 <- mu2 + sum(W(a)*flr0(ymid.a,a,beta,Pop=pop,year=year))
}
opti_size_popyear[p,yr] <- mu_size/mu2
opti_a_popyear[p,yr] <- mu_a/mu2
opti_beta_popyear[p,yr] <- beta
}
}
save(opti_size_popyear, file="IPM/Results/opti_size_popyear.RData")
save(opti_a_popyear, file="IPM/Results/opti_a_popyear.RData")
save(opti_beta_popyear, file="IPM/Results/opti_beta_popyear.RData")
save(lam_opti_popyear, file="IPM/Results/lam_opti_popyear.RData")
