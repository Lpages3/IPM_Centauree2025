# mu_a <- mu_a + sum(a*W(a)*flr0(ymid.a,a,pop,year=annees))
mu2 <- mu2 + sum(W(a)*flr0(ymid.a,a,beta[i],pop,year=annees))
}
mu_sizes_pop[p,i] <- mu_size/mu2
# mu_a <- mu_a/mu2
}
}
