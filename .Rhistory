gof_binom <- function(model) {
series_gof <- NULL
for(i in 1:1000) {
series_gof[i] <- gof(model)$p.value
}
return(mean(series_gof))
}
gof_binom(Survglm11)
gof_binom(Survglm12)
gof_binom(Flowglm2)
